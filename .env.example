# OpenAI API key (server-side only — never expose to the browser).
# Used by app/api/session/route.ts to mint ephemeral Realtime API tokens.
# Copy this file to .env.local and fill in the value:
#   cp .env.example .env.local
OPENAI_API_KEY=

# Allowed browser Origin for /api/session (exact match, no trailing slash).
# Required in production — unset in production rejects every request (fail closed).
# In development, leaving this blank implicitly allows http://localhost:3000.
APP_ORIGIN=http://localhost:3000
